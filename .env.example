NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend email API key — get from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# NOTE: Email from-addresses are configured in src/config/site.ts (EMAIL constant).
# To use custom domain senders (e.g. voucher@sherpaski.cz), verify the domain
# in Resend dashboard: Domains → Add Domain → add SPF + DKIM DNS records.
# Until domain is verified, keep using: onboarding@resend.dev (sandbox only).
